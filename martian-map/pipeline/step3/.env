# =========================================================================
# STEP 3 ENVIRONMENT CONFIGURATION (.env)
# =========================================================================

# --- Step 3 File Paths ---
STEP3_INPUT_NPZ_PATH=step2_output.npz
STEP3_OUTPUT_NPZ_PATH=step3_output.npz

# --- Step 3 Active Chunks & Stratified CDF Sampling Constants ---
STEP3_ACTIVE_CHUNKS=1,1;1,2
STEP3_SAMPLES_PER_CHUNK=900
STEP3_CDF_BASELINE_EPS=0.05
STEP3_HASH_PRIME_I=73856093
STEP3_HASH_PRIME_J=19349663
STEP3_HASH_SEED=2020
STEP3_HASH_BITMASK=4294967295
STEP3_INDEX_ZERO=0
STEP3_INDEX_ONE=1

# --- Step 3 KDTree & Line-of-Sight Edge Validation Constants ---
STEP3_EDGE_RADIUS_M=32.0
STEP3_LOS_INTERP_POINTS=15
STEP3_LAMBDA_MIN=0.0
STEP3_LAMBDA_MAX=1.0
STEP3_SEAM_STRIP_HALFWIDTH_PX=34

