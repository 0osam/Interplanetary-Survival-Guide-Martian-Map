# =========================================================================
# STEP 6 ENVIRONMENT CONFIGURATION (.env)
# =========================================================================

# --- Step 6 File Paths ---
STEP6_INPUT_NPZ_PATH=step5_output.npz
STEP6_OUTPUT_NPZ_PATH=step6_output.npz
STEP6_CESIUM_JSON_PATH=cesium_mars_mission_bundle.json

# --- Step 6 CesiumJS & Geodesy Export Constants ---
STEP6_CESIUM_VERSION=1.114+
STEP6_SITE_ID=jezero_delta
STEP6_MISSION_NAME=Mars 2020 Perseverance (Jezero Western Fan Delta)
STEP6_ROVER_MISSION_TAG=Mars 2020 Perseverance
STEP6_ROUTE_ALT_OFFSET_M=1.2
STEP6_MAX_EXPORTED_PNR_NODES=300
STEP6_DEG_IN_HALF_CIRCLE=180.0
STEP6_FULL_CIRCLE_DEG=360.0
STEP6_HALF_DIVISOR=2.0
STEP6_LONLAT_ROUND_DECIMALS=7
STEP6_ALT_ROUND_DECIMALS=2
STEP6_METRIC_ROUND_DECIMALS=4
STEP6_JSON_INDENT=2

# --- Step 6.1: 3D Ray-Cast Hab Radio Line-of-Sight (L_LOS) Constants ---
STEP6_HAB_ANTENNA_HEIGHT_M=6.5
STEP6_ASTRONAUT_HELMET_HEIGHT_M=1.7
STEP6_LOS_NUM_AZIMUTHS=720
STEP6_RAY_START_STEP=1

# --- Step 6.2: 8-Azimuth Canyon Radiation Shielding (R_rad) Constants ---
STEP6_RAD_CARDINAL_OFFSET_PX=6
STEP6_RAD_DIAGONAL_OFFSET_PX=4
STEP6_RAD_NORM_PI_DIVISOR=4.0

# --- Step 6.3: Perseverance Rover Street-View Sobel Calibration Constants ---
STEP6_ROVER_PATCH_SIZE_PX=64
STEP6_ROVER_PATCH_MEAN_DN=128.0
STEP6_ROVER_SOBEL_THRESH=95.0
STEP6_ROVER_ROUGH_BASE_M=0.08
STEP6_ROVER_ROUGH_SCALE_M=1.15
STEP6_ROVER_CAL_RADIUS_M=24.0
STEP6_EDGE_SCALE_NCU=14.0
STEP6_EDGE_SCALE_NCF=24.0
STEP6_EDGE_SCALE_NHDP=18.0
STEP6_EDGE_SCALE_NHDF=26.0
STEP6_EDGE_SCALE_NHL=30.0
STEP6_EDGE_SCALE_AEB=10.0
STEP6_EDGE_SCALE_ASU=56.0

