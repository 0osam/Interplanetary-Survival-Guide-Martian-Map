# =========================================================================
# STEP 2 ENVIRONMENT CONFIGURATION (.env)
# =========================================================================

# --- Step 2 File Paths ---
STEP2_INPUT_NPZ_PATH=step1_output.npz
STEP2_OUTPUT_NPZ_PATH=step2_output.npz

# --- Step 2 Stencil & Normalization Constants ---
STEP2_STENCIL_HALO_PX=1
STEP2_SOBEL_AXIS_ROW=0
STEP2_SOBEL_AXIS_COL=1
STEP2_GRAD_PERCENTILE_Q=99.0
STEP2_LAP_PERCENTILE_Q=99.0
STEP2_NORM_MIN_FLOOR=0.000001
STEP2_CLIP_MIN=0.0
STEP2_CLIP_MAX=1.0

# --- Step 2 Deviation Score Weights (w_grad + w_lap + w_unc = 1.0) ---
STEP2_WEIGHT_GRAD=0.45
STEP2_WEIGHT_LAP=0.30
STEP2_WEIGHT_UNC=0.25

# --- Step 2 Dummy Input Generator Constants ---
STEP2_DUMMY_RNG_SEED=2021
STEP2_DUMMY_CLIFF_COL_MIN=0.50
STEP2_DUMMY_CLIFF_COL_MAX=0.52
STEP2_DUMMY_GAP_ROW_MIN=0.45
STEP2_DUMMY_GAP_ROW_MAX=0.52
STEP2_DUMMY_BASE_COST=140.0
STEP2_DUMMY_SLOPE_COST_AMP=95.0
STEP2_DUMMY_NOISE_COST_STD=12.0
STEP2_DUMMY_ETA_BASE=1.35
STEP2_DUMMY_UNC_BASE=0.25
STEP2_DUMMY_UNC_BAND_AMP=0.45