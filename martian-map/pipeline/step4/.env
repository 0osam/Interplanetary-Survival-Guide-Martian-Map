STEP4_LEG_2_LABEL=Leg 2: Three Forks -> Hawksbill Gap (+12 kg)

STEP4_LEG_3_ID=LEG_3_EAST_CHUNK_MIGRATION
STEP4_LEG_3_START_WP=SOL_0580_HAWKSBILL_GAP
STEP4_LEG_3_GOAL_WP=SOL_1215_NERETVA_EAST
STEP4_LEG_3_SAMPLE_KG=26.0
