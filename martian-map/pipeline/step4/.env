# --- Step 4 File Paths ---
STEP4_INPUT_NPZ_PATH=step3_output.npz
STEP4_OUTPUT_NPZ_PATH=step4_output.npz

# --- Step 4 Astronaut & Martian Bioenergetic Constants ---
