STEP4_ROUND_DECIMALS=6

# --- Step 4 Mission Leg Payload Schedule ---
STEP4_NUM_MISSION_LEGS=4

STEP4_LEG_1_ID=LEG_1_OUTBOUND_DELTA
STEP4_LEG_1_START_WP=SOL_0001_BUTLER_HAB
